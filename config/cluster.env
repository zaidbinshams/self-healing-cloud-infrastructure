# Source from the repo root on Machine B:  source config/cluster.env
# No secrets here; credentials live in config/kube/ (gitignored).
_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"

export A_IP=192.168.137.10                                   # Machine A LAN IP (K3s node InternalIP)
export NS=boutique
export KUBE_ADMIN=$_REPO_ROOT/config/kube/admin.kubeconfig        # humans/bootstrap scripts only
export KUBE_AGENT=$_REPO_ROOT/config/kube/agent.kubeconfig        # env action executor only
export KUBE_CTRL=$_REPO_ROOT/config/kube/controller.kubeconfig    # fault injector + reset only
export PROM_URL=http://$A_IP:30090
export FRONTEND_URL=http://$A_IP:30080
export LOCUST_URL=http://127.0.0.1:8089

# Pinned versions (never "main"/"latest")
export OB_VERSION=v0.10.7                                    # Online Boutique release tag
export K3S_VERSION=v1.36.4+k3s1                              # as running on Machine A
export CHAOS_MESH_VERSION=2.8.4                              # Helm chart = app version (matches pre-existing install)
export HELM_VERSION=v3.18.4                                  # helm client on B (installed to ~/.local/bin)

unset _REPO_ROOT
